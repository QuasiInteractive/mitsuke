# Copy to .env and fill in. .env is gitignored — never put real values in this file.
THECARAPI_KEY=
# Optional: alerts go to the console when unset.
DISCORD_WEBHOOK_URL=
# Optional: decode auction sheets through Kensa-ya's partner API. Unset = alerts go out without a decoded sheet.
# The key must equal PARTNER_API_KEY on the Kensa-ya side (at least 32 characters).
KENSAYA_BASE_URL=
KENSAYA_PARTNER_KEY=
# Optional: the web app's address; alerts then end with a link to the lot page.
MITSUKE_WEB_URL=http://localhost:3001/
# Local dev database for docker compose. Pick any password; MITSUKE_DB must use the same one.
POSTGRES_PASSWORD=
MITSUKE_DB=Host=localhost;Port=5432;Database=mitsuke;Username=mitsuke;Password=
# Sign-in (Supabase Auth). Locally: `npx supabase start` prints it (http://127.0.0.1:64321).
SUPABASE_URL=

# Copy to .env.local. Local values come from `npx supabase start` (run in the repo root).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:64321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
MITSUKE_API_URL=http://localhost:5107

# Phone notifications: the public half of the VAPID key pair (same as VAPID_PUBLIC_KEY in ../.env). Empty hides the switch.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Set to true once a partner exporter takes bid requests; until then the bid button says it's a request.
NEXT_PUBLIC_BID_PARTNER_LIVE=
